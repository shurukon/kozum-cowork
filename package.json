{
  "name": "kozum-cowork",
  "version": "0.5.0",
  "description": "Kozum Cowork \u2014 a provider-agnostic desktop agent for Windows. Cowork and Code modes, no VM required.",
  "main": "./out/main/index.js",
  "author": "Kozum",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "python3 scripts/make_icons.py assets/logo-source.png build resources/icons && mkdir -p src/renderer/public/icons && cp resources/icons/mark-*.png resources/icons/logo-256.png src/renderer/public/icons/",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --experimental-strip-types --test tests/integration/*.test.ts tests/unit/*.test.ts",
    "test:capabilities": "node --experimental-strip-types scripts/validate-capabilities.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "verify": "npm run typecheck && npm run test && npm run test:capabilities",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.5.0",
    "croner": "^8.1.2",
    "electron-updater": "^6.3.9",
    "i18next": "^23.11.0",
    "lucide-react": "^0.460.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/adm-zip": "^0.5.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
